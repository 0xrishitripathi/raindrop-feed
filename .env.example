RAINDROP_TOKEN=your_raindrop_token_here
# Set this to a long, unique password in Vercel to require sign-in.
APP_ACCESS_PASSWORD=
# Optional: enables automatic bookmark labeling. Use a Gemini free-tier API key.
GEMINI_API_KEY=
# Added automatically when Upstash Redis is connected through the Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
